<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>base101_control</name>
  <version>0.0.0</version>
  <description>Controller configurations + hardware overlay for the base101 mobile base. Ships sim and hardware controllers.yaml for both variants, and a control_stack launch for real-hardware bringup.</description>
  <maintainer email="todo@todo.com">author</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <!-- ros2_control SystemInterface that bridges to the Axon firmware topics;
       referenced by urdf/base101.hardware.xacro. -->
  <exec_depend>base101_control_plugin</exec_depend>
  <exec_depend>base101_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
