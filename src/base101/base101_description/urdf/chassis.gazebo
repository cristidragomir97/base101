<?xml version="1.0" ?>
<robot name="base101_chassis" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Gazebo-only extensions for the shared chassis: visual materials, contact
     properties, and the three sensors. No gz_ros2_control plugin here, that
     block lives in each variant's top-level xacro so it can point at that
     variant's controllers.sim.yaml.

     self_collide is false on every link. The chassis is one rigid tree joined
     by fixed joints, so no two links can ever move into each other; leaving it
     on just asked the solver to test ~325 link pairs of full-resolution
     collision meshes on every step. Collision geometry itself is primitives
     (see scripts/collision_primitives.py), not the visual meshes.

     Sensors hang off the dedicated frame links declared in chassis.xacro
     (imu_link, lidar_frame, camera_link) rather than off the mesh links, so
     the published frame is the physical origin of the measurement. -->

<!-- D435: 87 deg HFOV. OAK-D: 69 deg on the RGB imager. -->
<xacro:property name="camera_hfov" value="${1.518 if '$(arg camera)' == 'realsense' else 1.204}" />

<!-- Mirrors the URDF palette in materials.xacro; keep the two in step. -->
<xacro:property name="extrusion_color"   value="Gazebo/DarkGrey" />
<xacro:property name="plate_color"       value="Gazebo/Grey" />
<xacro:property name="plastic_color"     value="Gazebo/Black" />
<xacro:property name="hardware_color"    value="Gazebo/Silver" />
<xacro:property name="pcb_color"         value="Gazebo/Green" />
<xacro:property name="electronics_color" value="Gazebo/DarkGrey" />
<xacro:property name="motor_color"       value="Gazebo/Black" />

<!-- ================================= IMU =================================
     The IMU is a chip on the link101 carrier board, not a separate module, so
     it reads out ~100 mm up and ~10 mm behind base_link. The EKF (ekf.sim.yaml
     imu0) and the robocore imu API both consume /sensors/imu in imu_link. -->
<gazebo reference="imu_link">
  <sensor name="base_imu" type="imu">
    <topic>sensors/imu</topic>
    <gz_frame_id>imu_link</gz_frame_id>
    <update_rate>100</update_rate>
    <always_on>1</always_on>
    <visualize>false</visualize>
  </sensor>
</gazebo>

<!-- ================================ lidar ================================ -->
<gazebo reference="lidar_frame">
  <sensor name="lidar" type="gpu_lidar">
    <topic>scan</topic>
    <gz_frame_id>lidar_frame</gz_frame_id>
    <update_rate>10</update_rate>
    <always_on>1</always_on>
    <visualize>true</visualize>
    <lidar>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.12</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
  </sensor>
</gazebo>

<!-- ====================== base camera (rgb + depth) ======================
     Both sensors sit on camera_link (front face of whichever module is
     fitted, +X out of the lens) so rgb and depth share intrinsics, stamps and
     frame: robocore's get_depth / get_synced / deproject / get_cloud all
     assume that pairing. Topic names stay /base_camera/* whichever camera the
     `camera` arg selects, so the gz bridges do not care.

     FRAME: messages are stamped with camera_optical_frame (REP-103 optical
     axes: z out of the lens, x right, y down), NOT camera_link. That is what
     the real drivers do — realsense2_camera sets both
     `camera_info.header.frame_id` and `img_msg->header.frame_id` from
     OPTICAL_FRAME_ID(), and depthai publishes oak_*_camera_optical_frame — so
     sim and hardware agree and nothing has to be re-taught when the real
     module goes on.

     Keeping ONE optical frame shared by rgb and depth is deliberate. Real
     hardware exposes a per-sensor frame each, but depth is normally aligned to
     colour (realsense `align_depth`), which publishes depth in the colour
     optical frame — the same pairing robocore's deprojection needs.

     ROBOCORE: the camera's profile entry must say `optical: true`. With
     `optical: false` robocore applies its OPTICAL_TO_LINK rotation to points
     that are already optical, and every deprojection is silently wrong by 90
     degrees. See docs/robocore-camera-frames.md. -->
<gazebo reference="camera_link">
  <sensor name="base_camera" type="camera">
    <topic>base_camera/image_raw</topic>
    <gz_frame_id>camera_optical_frame</gz_frame_id>
    <update_rate>30</update_rate>
    <always_on>1</always_on>
    <visualize>true</visualize>
    <camera>
      <horizontal_fov>${camera_hfov}</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>20.0</far>
      </clip>
    </camera>
  </sensor>

  <sensor name="base_camera_depth" type="depth_camera">
    <topic>base_camera/depth_image</topic>
    <gz_frame_id>camera_optical_frame</gz_frame_id>
    <update_rate>30</update_rate>
    <always_on>1</always_on>
    <visualize>false</visualize>
    <camera>
      <horizontal_fov>${camera_hfov}</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R_FLOAT32</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>20.0</far>
      </clip>
    </camera>
  </sensor>
</gazebo>

<!-- ================================ frame ================================ -->
<gazebo reference="base_link">
  <material>${plate_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
  <gravity>true</gravity>
</gazebo>
<gazebo reference="box_front_1">
  <material>${extrusion_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="box_back_1">
  <material>${extrusion_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="box_left_1">
  <material>${extrusion_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="box_right_1">
  <material>${extrusion_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>

<!-- ============================== drivetrain ==============================
     The rims carry the traction contact: high mu1 along fdir1, low mu2
     across, stiff contact (kp/kd). The hubs are non-colliding internals. -->
<gazebo reference="wheel_front_left_1">
  <material>${motor_color}</material>
  <mu1>1.0</mu1>
  <mu2>0.1</mu2>
  <fdir1>1 0 0</fdir1>
  <kp>10000000.0</kp>
  <kd>1.0</kd>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="wheel_front_right_1">
  <material>${motor_color}</material>
  <mu1>1.0</mu1>
  <mu2>0.1</mu2>
  <fdir1>1 0 0</fdir1>
  <kp>10000000.0</kp>
  <kd>1.0</kd>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="wheel_back_left_1">
  <material>${motor_color}</material>
  <mu1>1.0</mu1>
  <mu2>0.1</mu2>
  <fdir1>1 0 0</fdir1>
  <kp>10000000.0</kp>
  <kd>1.0</kd>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="wheel_back_right_1">
  <material>${motor_color}</material>
  <mu1>1.0</mu1>
  <mu2>0.1</mu2>
  <fdir1>1 0 0</fdir1>
  <kp>10000000.0</kp>
  <kd>1.0</kd>
  <self_collide>false</self_collide>
</gazebo>

<gazebo reference="wheel_hub_front_left_1">
  <material>${motor_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="wheel_hub_front_right_1">
  <material>${motor_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="wheel_hub_back_left_1">
  <material>${motor_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="wheel_hub_back_right_1">
  <material>${motor_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>

<gazebo reference="mount_front_left_1">
  <material>${plastic_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="mount_front_right_1">
  <material>${plastic_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="mount_back_left_1">
  <material>${plastic_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="mount_back_right_1">
  <material>${plastic_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>

<!-- =============================== bumpers =============================== -->
<gazebo reference="bumper_front_left_1">
  <material>${plastic_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="bumper_front_right_1">
  <material>${plastic_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="bumper_back_left_1">
  <material>${plastic_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="bumper_back_right_1">
  <material>${plastic_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>

<!-- ============================ payload deck ============================ -->
<gazebo reference="standoff_front_left_1">
  <material>${hardware_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="standoff_front_right_1">
  <material>${hardware_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="standoff_back_left_1">
  <material>${hardware_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="standoff_back_right_1">
  <material>${hardware_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="top_plate_1">
  <material>${plate_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>

<!-- ========================= mounts / accessories ========================= -->
<gazebo reference="lidar_mount_1">
  <material>${plastic_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="lidar_1">
  <material>${motor_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="camera_edge_bracket_1">
  <material>${plastic_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<xacro:if value="${'$(arg camera)' == 'realsense'}">
  <gazebo reference="camera_realsense_1">
    <material>${electronics_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>
</xacro:if>
<xacro:if value="${'$(arg camera)' == 'oak_d'}">
  <gazebo reference="camera_luxonis_1">
    <material>${electronics_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>
</xacro:if>
<gazebo reference="jetson_mount_1">
  <material>${plastic_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="orin_simplified_1">
  <material>${electronics_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="orp_link101_mount_1">
  <material>${plastic_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="link_101_1">
  <material>${pcb_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>

</robot>
