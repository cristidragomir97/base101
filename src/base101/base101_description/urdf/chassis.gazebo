<?xml version="1.0" ?>
<robot name="base101_simple" xmlns:xacro="http://www.ros.org/wiki/xacro">


<xacro:property name="body_color" value="Gazebo/Grey" />
<xacro:property name="silver_color" value="Gazebo/Silver" />
<xacro:property name="motor_color" value="Gazebo/Black" />
<xacro:property name="accent_color" value="Gazebo/Green" />

<!-- ===================== base + IMU ===================== -->
<gazebo reference="base_link">
  <material>${motor_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>

  <!-- IMU at the base origin: feeds the EKF (ekf.sim.yaml imu0) and the
       robocore imu API. Additive: existing topics are untouched. -->
  <sensor name="base_imu" type="imu">
    <topic>sensors/imu</topic>
    <gz_frame_id>base_link</gz_frame_id>
    <update_rate>100</update_rate>
    <always_on>1</always_on>
    <visualize>false</visualize>
  </sensor>
</gazebo>

<!-- ===================== lidar ===================== -->
<gazebo reference="lidar_1">
  <material>${motor_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="lidar_mount_1">
  <material>${silver_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="lidar_frame">
  <sensor name="lidar" type="gpu_lidar">
    <topic>scan</topic>
    <gz_frame_id>lidar_frame</gz_frame_id>
    <update_rate>10</update_rate>
    <always_on>1</always_on>
    <visualize>true</visualize>
    <lidar>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.12</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
  </sensor>
</gazebo>

<!-- ===================== base camera (rgb + depth) ===================== -->
<gazebo reference="base_camera_1">
  <material>${motor_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>

  <sensor name="base_camera" type="camera">
    <topic>base_camera/image_raw</topic>
    <gz_frame_id>base_camera_1</gz_frame_id>
    <update_rate>30</update_rate>
    <always_on>1</always_on>
    <visualize>true</visualize>
    <camera>
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>20.0</far>
      </clip>
    </camera>
  </sensor>

  <!-- Depth sensor co-located with base_camera, same fov/resolution/rate,
       so the rgb/depth pair shares intrinsics and stamps (robocore
       get_depth / get_synced / deproject / get_cloud). Additive: existing
       topics are untouched; real hardware maps its own depth topic in the
       robot profile. -->
  <sensor name="base_camera_depth" type="depth_camera">
    <topic>base_camera/depth_image</topic>
    <gz_frame_id>base_camera_1</gz_frame_id>
    <update_rate>30</update_rate>
    <always_on>1</always_on>
    <visualize>false</visualize>
    <camera>
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R_FLOAT32</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>20.0</far>
      </clip>
    </camera>
  </sensor>
</gazebo>

<!-- ===================== wheels ===================== -->
<!-- The outside wheels carry the traction contact: high mu1 along fdir1,
     low mu2 across, stiff contact (kp/kd). The inside hubs are non-colliding
     internal links. -->
<gazebo reference="wheel_outside_FR_1">
  <material>${motor_color}</material>
  <mu1>1.0</mu1>
  <mu2>0.1</mu2>
  <fdir1>1 0 0</fdir1>
  <kp>10000000.0</kp>
  <kd>1.0</kd>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="wheel_outside_FL_1">
  <material>${motor_color}</material>
  <mu1>1.0</mu1>
  <mu2>0.1</mu2>
  <fdir1>1 0 0</fdir1>
  <kp>10000000.0</kp>
  <kd>1.0</kd>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="wheel_outside_BL_1">
  <material>${motor_color}</material>
  <mu1>1.0</mu1>
  <mu2>0.1</mu2>
  <fdir1>1 0 0</fdir1>
  <kp>10000000.0</kp>
  <kd>1.0</kd>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="wheel_outside_BR_1">
  <material>${motor_color}</material>
  <mu1>1.0</mu1>
  <mu2>0.1</mu2>
  <fdir1>1 0 0</fdir1>
  <kp>10000000.0</kp>
  <kd>1.0</kd>
  <self_collide>false</self_collide>
</gazebo>

<gazebo reference="wheel_inside_FR_1">
  <material>${motor_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="wheel_inside_FL_1">
  <material>${motor_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="wheel_inside_BL_1">
  <material>${motor_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="wheel_inside_BR_1">
  <material>${motor_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>

<gazebo reference="motor_support_fr_1">
  <material>${silver_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="motor_support_fl_1">
  <material>${silver_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="motor_support_bl_1">
  <material>${silver_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="motor_support_br_1">
  <material>${silver_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<!-- ===================== chassis boxes + deck ===================== -->
<gazebo reference="box_right_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="box_left_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="box_front_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="box_back_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="top_plate_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<!-- ===================== bumpers ===================== -->
<gazebo reference="bumper_fl_1">
  <material>${accent_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="bumper_fr_1">
  <material>${accent_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="bumper_bl_1">
  <material>${accent_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="bumper_br_1">
  <material>${accent_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<!-- ===================== mounts / accessories ===================== -->
<gazebo reference="realsense_support_1">
  <material>${silver_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="imu_1">
  <material>${motor_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="connector_mask_1">
  <material>${silver_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="connector_cap_l_1">
  <material>${silver_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="connector_cap_r_1">
  <material>${silver_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="baseus_1">
  <material>${silver_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="baseus_front_holder_1">
  <material>${silver_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>
<gazebo reference="baseus_back_holder_1">
  <material>${silver_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

</robot>
