</joint>

<joint name="bumper_back_right_joint" type="fixed">
  <origin xyz="-0.17 -0.12 0.084965" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="bumper_back_right_1"/>
</joint>

<!-- ============================== payload deck ==============================
     top_plate_1 rides 45 mm of standoff above base_link. It is the mount
     point every add-on variant (arm, tower) parents to: renaming it
