<?xml version="1.0" ?>
<robot name="base101_chassis" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Shared base101 chassis geometry. Materials, the gz_ros2_control plugin and
     the sensor/friction extensions (chassis.gazebo, chassis.*.ros2control) are
     pulled in by the variant xacros, not here.

     Folded by hand from the Fusion 360 export (see scripts/import_cad_export.py
     for the mesh side of the same import). Everything below is in the export's
     global CAD frame, in millimetres scaled by 0.001, which is why every
     visual/collision origin is just the negated position of its own link.

     base_link sits on the wheel contact plane (CAD z = -81.965 mm), centred on
     the chassis, so odom/nav/diff_drive see a ground-level origin. The rest of
     the tree keeps the exported positions verbatim.

     Camera choice is an argument: the edge bracket takes either a RealSense
     D435 or a Luxonis OAK-D, and both mount to the same face. Whichever is
     fitted, the stable frames are camera_link / camera_optical_frame. -->

<xacro:arg name="camera" default="realsense"/>

<!-- ================================= frame =================================
     Two 60x20 extrusion rails plus front/back cross members, with the
     3 mm top deck (base_link) closing the box. -->

<link name="base_link">
  <inertial>
    <origin xyz="-0.00433828 0 0.083465" rpy="0 0 0"/>
    <mass value="1.81049"/>
    <inertia ixx="0.00899888" iyy="0.0171197" izz="0.0261159" ixy="0" iyz="0" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0.081965" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="plate_aluminum"/>
  </visual>
  <collision>
    <origin xyz="0 0 0.083465" rpy="0 0 0"/>
    <geometry>
      <box size="0.34 0.24 0.003"/>
    </geometry>
  </collision>
</link>

<link name="box_front_1">
  <inertial>
    <origin xyz="-0.00962595 0 -0.03" rpy="0 0 0"/>
    <mass value="0.740521"/>
    <inertia ixx="0.003275" iyy="0.000289" izz="0.003048" ixy="0" iyz="0" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="-0.17 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_description)/meshes/box_front_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="extrusion_grey"/>
  </visual>
  <collision>
    <origin xyz="-0.01 0 -0.03" rpy="0 0 0"/>
    <geometry>
      <box size="0.02 0.24 0.06"/>
    </geometry>
  </collision>
</link>

<link name="box_back_1">
  <inertial>
    <origin xyz="0.00962595 0 -0.03" rpy="0 0 0"/>
    <mass value="0.740521"/>
