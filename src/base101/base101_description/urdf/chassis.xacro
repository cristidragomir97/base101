  <parent link="lidar_1"/>
  <child link="lidar_frame"/>
</joint>

<!-- ================================= camera =================================
     One bracket, two options. camera_link is the front face of whichever
     module is fitted, +X out of the lens; camera_optical_frame is the
     REP-103 optical twist of it for point clouds. -->

<link name="camera_edge_bracket_1">
  <inertial>
    <origin xyz="-0.0234361 -0.05 -0.00264041" rpy="0 0 0"/>
    <mass value="0.40831"/>
    <inertia ixx="0.000606377" iyy="0.000544929" izz="0.00108709" ixy="0" iyz="0" ixz="6.71514e-05"/>
