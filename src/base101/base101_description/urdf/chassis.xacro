  <origin xyz="0.17 -0.12 0.081965" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="box_right_1"/>
</joint>

<!-- =============================== drivetrain ===============================
     Printed mount, then hub, then rim, per corner. The DDSM210 stator is bolted
     into the mount and does not turn, so it is its own fixed link; only
     the rim hangs off the revolute joint. Axis is +Y on all four so a
     positive diff_drive command drives forward on both sides. -->

<link name="mount_front_left_1">
  <inertial>
    <origin xyz="0.0252801 0.00623325 -0.00938469" rpy="0 0 0"/>
    <mass value="0.120821"/>
    <inertia ixx="1e-05" iyy="5.1e-05" izz="4.4e-05" ixy="0" iyz="0" ixz="0"/>
