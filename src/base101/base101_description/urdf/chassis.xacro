        <mesh filename="file://$(find base101_description)/meshes/camera_realsense_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="electronics_grey"/>
    </visual>
  <collision>
    <origin xyz="0.012525 0.0225433 -2.15769e-08" rpy="0 0 0"/>
    <geometry>
      <box size="0.02505 0.0898433 0.025"/>
