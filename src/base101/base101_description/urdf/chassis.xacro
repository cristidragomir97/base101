  <collision>
    <origin xyz="-0.0214997 -0.0215 0.0206499" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="0.0278" length="0.0413"/>
    </geometry>
  </collision>
</link>

<joint name="lidar_mount_joint" type="fixed">
  <origin xyz="0.1 0.05 0.081965" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lidar_mount_1"/>
