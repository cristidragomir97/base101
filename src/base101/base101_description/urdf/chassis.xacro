<!-- Laser scan origin. The gpu_lidar sensor (base101_simple.gazebo) publishes
     /scan stamped in lidar_frame; nav/slam consume that frame. Offset reused
     from the prior working export (lidar mesh unchanged). -->
<link name="lidar_frame"/>
<joint name="lidar_frame_joint" type="fixed">
  <origin xyz="-0.021416 -0.021595 0.044018" rpy="0 0 0"/>
  <parent link="lidar_1"/>
  <child link="lidar_frame"/>
</joint>

