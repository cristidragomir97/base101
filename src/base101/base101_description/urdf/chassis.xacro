<joint name="front_right_wheel_joint" type="continuous">
  <!-- Origin/axis normalised to the working symmetric values; the raw CAD
       export left a stray un-zeroed origin here and flipped the axis sign.
       Axis +Y so diff_drive_controller forward command drives forward. -->
  <origin xyz="0.0 -0.019416 0.0" rpy="0 0 0"/>
  <parent link="wheel_inside_FR_1"/>
  <child link="wheel_outside_FR_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

