  <parent link="base_link"/>
  <child link="camera_edge_bracket_1"/>
</joint>

<xacro:if value="${'$(arg camera)' == 'realsense'}">
  <link name="camera_realsense_1">
    <inertial>
      <origin xyz="0.0116574 0.0239083 -2.34873e-05" rpy="0 0 0"/>
      <mass value="0.0720014"/>
      <inertia ixx="4.6e-05" iyy="7e-06" izz="4.7e-05" ixy="0" iyz="0" ixz="0"/>
    </inertial>
