<!-- ================================= lidar =================================
     RPLidar C1. lidar_frame is the scan origin: the rotor axis, at the
     height of the optical window between the base and the spinning cap
     (CAD z = 14.5 mm, i.e. 96.5 mm off the floor). /scan is stamped in
     it and slam/nav consume it from there. -->

<link name="lidar_mount_1">
  <inertial>
    <origin xyz="0.0117249 -0.0501338 -0.0161636" rpy="0 0 0"/>
    <mass value="0.20407"/>
    <inertia ixx="0.000244" iyy="8.4e-05" izz="0.000322" ixy="0" iyz="0" ixz="-2e-06"/>
  </inertial>
