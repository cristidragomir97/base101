    </geometry>
    <material name="plastic_black"/>
  </visual>
  <collision>
    <origin xyz="0.01035 -0.05 -0.00945654" rpy="0 0 0"/>
    <geometry>
      <box size="0.0688 0.1095 0.0189131"/>
    </geometry>
  </collision>
</link>

