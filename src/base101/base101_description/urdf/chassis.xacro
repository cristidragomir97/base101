  <joint name="camera_luxonis_joint" type="fixed">
    <origin xyz="0.014 -0.0125 -0.0085" rpy="0 0 0"/>
    <parent link="camera_edge_bracket_1"/>
    <child link="camera_luxonis_1"/>
  </joint>

  <link name="camera_link"/>
  <joint name="camera_link_joint" type="fixed">
    <origin xyz="0.01745 -0.0375 -0.0045" rpy="0 0 0"/>
    <parent link="camera_luxonis_1"/>
    <child link="camera_link"/>
  </joint>
</xacro:if>

<link name="camera_optical_frame"/>
<joint name="camera_optical_frame_joint" type="fixed">
  <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  <parent link="camera_link"/>
  <child link="camera_optical_frame"/>
</joint>

<!-- =========================== compute + link101 ===========================
     Orin on its printed tray at the back; the link101 carrier board on its
     own tray amidships. The IMU lives on the link101 PCB, so imu_link
     hangs off that board (centre of the board, top copper) rather than
     off base_link, so the EKF gets the real lever arm. -->

