    </geometry>
  </collision>
</link>

<link name="box_left_1">
  <inertial>
    <origin xyz="-0.17 -0.00974265 -0.0299929" rpy="0 0 0"/>
    <mass value="1.07632"/>
    <inertia ixx="0.00042" iyy="0.009599" izz="0.009268" ixy="0" iyz="0" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="-0.17 -0.12 0" rpy="0 0 0"/>
    <geometry>
