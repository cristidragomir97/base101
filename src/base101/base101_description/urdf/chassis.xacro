<?xml version="1.0" ?>
<robot name="base101_simple" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Pure geometry for the base101 simple variant. Materials, the gz_ros2_control
     plugin + sensors (base101_simple.gazebo) and the ros2_control system
     (base101.gazebo.ros2control) are pulled in by the base101.xacro dispatcher,
     not here. The arm mount deck (hex standoffs + Component88) and the mod101
     arm are an overlay — see the base101_arm package. -->
<!-- base_link is recentred on the wheel-contact centroid: the raw CAD export
     placed the origin off-centre, so the whole chassis (this link's geometry +
     its two box children) is shifted by O = (0.0442785, 0.054181, 0) = -centroid.
     After the shift the wheels sit symmetrically about the origin (box children
     at Y = +/-0.12), which is what diff_drive / the nav footprint assume. -->
<link name="base_link">
  <inertial>
    <origin xyz="-0.0009677230747272545 0.0001918701345329512 0.022138382221213098" rpy="0 0 0"/>
    <mass value="1.8682863061101787"/>
    <inertia ixx="0.008987" iyy="0.017929" izz="0.026913" ixy="-5e-05" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.0442785 0.054181 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.0442785 0.054181 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

