  </joint>

  <link name="camera_link"/>
  <joint name="camera_link_joint" type="fixed">
    <origin xyz="0.02505 0.0225 0" rpy="0 0 0"/>
    <parent link="camera_realsense_1"/>
    <child link="camera_link"/>
  </joint>
</xacro:if>

<xacro:if value="${'$(arg camera)' == 'oak_d'}">
  <link name="camera_luxonis_1">
    <inertial>
      <origin xyz="0.00916344 -0.0373052 -0.0044071" rpy="0 0 0"/>
      <mass value="0.157097"/>
      <inertia ixx="0.000123" iyy="1.6e-05" izz="0.000117" ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <visual>
      <origin xyz="-0.174 -0.0375 0.0055" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find base101_description)/meshes/camera_luxonis_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="electronics_grey"/>
    </visual>
  <collision>
    <origin xyz="0.00872501 -0.0375 -0.0045" rpy="0 0 0"/>
    <geometry>
      <box size="0.01745 0.091 0.028"/>
