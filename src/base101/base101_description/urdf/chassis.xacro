<joint name="box_front_joint" type="fixed">
  <origin xyz="0.17 0 0.081965" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="box_front_1"/>
</joint>

<joint name="box_back_joint" type="fixed">
  <origin xyz="-0.17 0 0.081965" rpy="0 0 0"/>
