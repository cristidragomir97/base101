<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>base101_simple_control</name>
  <version>0.0.0</version>
  <description>
    Controllers and real-hardware bringup for the base101 simple variant:
    the diff_drive + joint_state_broadcaster params (sim and hw) and the
    hardware ros2_control overlay that bridges the wheels to the Axon firmware
    via base101_control_plugin.
  </description>
  <maintainer email="cristidragomir97@gmail.com">Cristi Dragomir</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>base101_simple_description</exec_depend>
  <exec_depend>base101_control</exec_depend>
  <exec_depend>base101_control_plugin</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>twist_mux</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
