<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>base101_simple_description</name>
  <version>0.0.0</version>
  <description>
    base101 "simple" variant description: the bare chassis with no add-ons.
    Assembles the shared base101_description chassis into a complete robot and
    provides the rviz display launch.
  </description>
  <maintainer email="cristidragomir97@gmail.com">Cristi Dragomir</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>base101_description</exec_depend>
  <!-- The gazebo branch's gz_ros2_control plugin loads
       base101_simple_control/config/controllers.sim.yaml, but we do NOT declare
       that here: base101_simple_control includes this package's hardware xacro,
       so declaring it back would form a dependency cycle. The gazebo bringup
       (base101_simple_gazebo) depends on both, which is what actually needs the
       controller file present. -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
