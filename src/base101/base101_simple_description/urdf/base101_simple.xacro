<?xml version="1.0" ?>
<!-- base101 "simple" variant: the bare chassis, no add-ons.

     Assembles the shared chassis (base101_description) into a complete,
     launchable robot. The arm and tower variants are sibling packages
     (base101_arm_description / base101_tower_description) that include the
     same chassis and layer their hardware on top. -->
<robot name="base101_simple" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- gazebo | mujoco | isaac | none. `none` = real-hw / rviz-only (no sim
       ros2_control or extension tags). -->
  <xacro:arg name="simulator" default="gazebo"/>

  <!-- Shared chassis: chassis links + materials. -->
  <xacro:include filename="$(find base101_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find base101_description)/urdf/chassis.xacro"/>

  <xacro:if value="${'$(arg simulator)' == 'gazebo'}">
    <!-- Wheel ros2_control system (GazeboSimSystem) + sensor/material tags. -->
    <xacro:include filename="$(find base101_description)/urdf/chassis.gazebo.ros2control"/>
    <xacro:include filename="$(find base101_description)/urdf/chassis.gazebo"/>
    <!-- gz_ros2_control loads this variant's controllers when the model is
         spawned. The controller params live with the variant's control pkg. -->
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find base101_simple_control)/config/controllers.sim.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

  <xacro:if value="${'$(arg simulator)' == 'mujoco'}">
    <xacro:include filename="$(find base101_description)/urdf/chassis.mujoco.ros2control"/>
  </xacro:if>

  <!-- simulator=isaac: driven natively from base101_isaac (no ros2_control).
       simulator=none: real-hw ros2_control comes from base101_simple_control's
       hardware xacro. -->

</robot>
