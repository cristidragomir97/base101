<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>base101_simple_gazebo</name>
  <version>0.0.0</version>
  <description>
    Gazebo Sim bringup for the base101 simple variant: spawns
    base101_simple_description in a world, bridges the chassis sensors, and
    spawns the wheel controllers. Worlds and the gz/ros bridge config live in
    the shared base101_gazebo package.
  </description>
  <maintainer email="cristidragomir97@gmail.com">Cristi Dragomir</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>base101_simple_description</exec_depend>
  <exec_depend>base101_simple_control</exec_depend>
  <exec_depend>base101_gazebo</exec_depend>
  <exec_depend>base101_control</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>rosboard</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
