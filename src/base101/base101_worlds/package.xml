<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>base101_worlds</name>
  <version>0.0.0</version>
  <description>
    Sim-common assets for the base101 mobile base: Gazebo Sim worlds, the
    ros_gz bridge config, and the sim RViz preset. Assets only — the launch
    that consumes them lives in base101_bringup_gazebo.
  </description>
  <maintainer email="cristian@robocore.dev">Cristian Dragomir</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The bridge config names ros_gz types, and the worlds name gz system
       plugins; the processes that read them are started by the bringup
       package, which depends on them itself. -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
