<?xml version="1.0" ?>
<robot name="base101_arm_mount" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Gazebo extensions for the arm mount deck. Included from base101_arm.xacro
     when simulator==gazebo. The mod101 arm's own gazebo blocks come from the
     mod101 macro. -->

<xacro:property name="mount_silver" value="Gazebo/Silver" />

<gazebo reference="hex1_1">
  <material>${mount_silver}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="hex2_1">
  <material>${mount_silver}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="hex3_1">
  <material>${mount_silver}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>
<gazebo reference="hex4_1">
  <material>${mount_silver}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>

<gazebo reference="arm_mount_plate">
  <material>${mount_silver}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
</gazebo>

</robot>
