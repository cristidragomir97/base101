<?xml version="1.0" ?>
<!-- Arm mount deck: four M-series hex standoffs and the arm_mount_plate.

     Bolted onto the simple variant's top_plate_1 at the standoff holes
     (X = 0.09 / 0.25 m on the deck — moved 80 mm back from the
     original 0.17 / 0.33 front position). The plate rides on hex3 and carries the
     mod101 arm (see arm.xacro). Link/joint origins are taken verbatim from the
     CAD export so the meshes land in the same place as on the real robot.

     This deck only fits the simple variant (top_plate_1 is a simple-variant
     link). Front mount only for now; the back/middle hole sets can be added
     later by parameterising the hex joint X offsets. -->
<robot name="base101_arm_mount" xmlns:xacro="http://www.ros.org/wiki/xacro">

<link name="hex1_1">
  <inertial>
    <origin xyz="2.0110764438474593e-07 -6.707330480609786e-08 0.022500382221212423" rpy="0 0 0"/>
    <mass value="0.009987908443925534"/>
    <inertia ixx="2e-06" iyy="2e-06" izz="0.0" ixy="0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.044709 -0.055819 -0.086638" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_arm_description)/meshes/hex1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.044709 -0.055819 -0.086638" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_arm_description)/meshes/hex1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="hex2_1">
  <inertial>
    <origin xyz="2.0110764309411167e-07 -6.707330480609786e-08 0.02250038222121213" rpy="0 0 0"/>
    <mass value="0.009987908443925532"/>
    <inertia ixx="2e-06" iyy="2e-06" izz="0.0" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.115291 -0.055819 -0.086638" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_arm_description)/meshes/hex2_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.115291 -0.055819 -0.086638" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_arm_description)/meshes/hex2_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="hex3_1">
  <inertial>
    <origin xyz="2.011076428165559e-07 -6.70733062424489e-08 0.022500382221211285" rpy="0 0 0"/>
    <mass value="0.009987908443925532"/>
    <inertia ixx="2e-06" iyy="2e-06" izz="0.0" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.115291 0.164181 -0.086638" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_arm_description)/meshes/hex3_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.115291 0.164181 -0.086638" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_arm_description)/meshes/hex3_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="hex4_1">
  <inertial>
    <origin xyz="2.0110764296227268e-07 -6.707330593713756e-08 0.022500382221210993" rpy="0 0 0"/>
    <mass value="0.009987908443925534"/>
    <inertia ixx="2e-06" iyy="2e-06" izz="0.0" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.044709 0.164181 -0.086638" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_arm_description)/meshes/hex4_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.044709 0.164181 -0.086638" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_arm_description)/meshes/hex4_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="arm_mount_plate">
  <inertial>
    <origin xyz="-0.07995048799762572 0.10999993292654 0.0015003822212114881" rpy="0 0 0"/>
    <mass value="0.9903241058429343"/>
    <inertia ixx="0.004737" iyy="0.002662" izz="0.007398" ixy="-0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.115291 0.164181 -0.131638" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_arm_description)/meshes/arm_mount_plate.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.115291 0.164181 -0.131638" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_arm_description)/meshes/arm_mount_plate.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<!-- Standoffs bolted to the deck (80 mm back of the front hole set). -->
<joint name="hex1_mount" type="fixed">
  <origin xyz="0.09 0.11 0.003" rpy="0 0 0"/>
  <parent link="top_plate_1"/>
  <child link="hex1_1"/>
</joint>

<joint name="hex2_mount" type="fixed">
  <origin xyz="0.25 0.11 0.003" rpy="0 0 0"/>
  <parent link="top_plate_1"/>
  <child link="hex2_1"/>
</joint>

<joint name="hex3_mount" type="fixed">
  <origin xyz="0.25 -0.11 0.003" rpy="0 0 0"/>
  <parent link="top_plate_1"/>
  <child link="hex3_1"/>
</joint>

<joint name="hex4_mount" type="fixed">
  <origin xyz="0.09 -0.11 0.003" rpy="0 0 0"/>
  <parent link="top_plate_1"/>
  <child link="hex4_1"/>
</joint>

<!-- Plate sits on top of the standoffs (rides on hex3). -->
<joint name="arm_plate_mount" type="fixed">
  <origin xyz="0.0 0.0 0.045" rpy="0 0 0"/>
  <parent link="hex3_1"/>
  <child link="arm_mount_plate"/>
</joint>

</robot>
