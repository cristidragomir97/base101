<?xml version="1.0" ?>
<!-- base101 "arm" variant: chassis + a single deck-mounted mod101 arm.

     Assembles the shared chassis (base101_description) and puts one mod101
     arm on its deck. There is no mount deck of its own any more: the 2026-08
     chassis re-export raised top_plate_1 onto 45 mm standoffs, which is
     exactly what this package used to add on top of the old flat deck, so the
     arm bolts straight to the chassis.
     `arm:=true` requires the mod101 underlay sourced (build mod101 first).
     Controllers live in base101_arm_control. -->
<robot name="base101_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="simulator" default="gazebo"/>
  <xacro:arg name="arm" default="true"/>
  <!-- arm_tool is declared in arm.xacro, defaulting to the configurator's
       `tool`. Declaring it here with a literal default would shadow that. -->

  <!-- Shared chassis. -->
  <xacro:include filename="$(find base101_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find base101_description)/urdf/chassis.xacro"/>

  <!-- One mod101 arm on the chassis deck. -->
  <xacro:if value="$(arg arm)">
    <xacro:include filename="$(find base101_arm_description)/urdf/arm.xacro"/>
  </xacro:if>

  <xacro:if value="${'$(arg simulator)' == 'gazebo'}">
    <xacro:include filename="$(find base101_description)/urdf/chassis.gazebo.ros2control"/>
    <xacro:include filename="$(find base101_description)/urdf/chassis.gazebo"/>
    <!-- gz_ros2_control loads this variant's controllers (wheels + arm). The
         arm joints' ros2_control blocks are emitted by the mod101 macro
         (use_sim=true) in arm.xacro. -->
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find base101_arm_control)/config/controllers.sim.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

  <xacro:if value="${'$(arg simulator)' == 'mujoco'}">
    <xacro:include filename="$(find base101_description)/urdf/chassis.mujoco.ros2control"/>
  </xacro:if>

</robot>
