<?xml version="1.0" ?>
<robot name="base101" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="variant" default="simple"/>

  <!-- When true, the URDF pulls in the Gazebo ros2_control plugin and per-link
       gazebo extensions. Hardware launches (base101_control) override to false. -->
  <xacro:arg name="use_sim" default="true"/>

  <xacro:include filename="$(find base101_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find base101_description)/urdf/base101_$(arg variant).xacro"/>

  <xacro:if value="$(arg use_sim)">
    <xacro:include filename="$(find base101_description)/urdf/base101.ros2control"/>
    <xacro:include filename="$(find base101_description)/urdf/base101_$(arg variant).gazebo"/>
  </xacro:if>

</robot>
