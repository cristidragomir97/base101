<?xml version="1.0" ?>
<robot name="base101" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="variant" default="simple"/>

  <!-- Which simulator the URDF is being prepared for. Selects the
       ros2_control hardware plugin and any sim-specific extension tags.
       Use `none` for real-hardware bringup (handled in base101_control). -->
  <xacro:arg name="simulator" default="gazebo"/>

  <!-- Cross tower add-on: column with prismatic lift + pan/tilt head. -->
  <xacro:arg name="tower" default="false"/>

  <!-- Dual mod101 arms on the tower's crossbeam brackets. Requires
       tower:=true and the mod101 workspace sourced as an underlay. -->
  <xacro:arg name="arms" default="false"/>
  <xacro:arg name="arm_tool" default="jaws"/>

  <xacro:include filename="$(find base101_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find base101_description)/urdf/base101_$(arg variant).xacro"/>

  <xacro:if value="$(arg tower)">
    <xacro:include filename="$(find base101_description)/urdf/base101_tower.xacro"/>
  </xacro:if>

  <xacro:if value="$(arg arms)">
    <xacro:include filename="$(find base101_description)/urdf/base101_arms.xacro"/>
  </xacro:if>

  <xacro:if value="${'$(arg simulator)' == 'gazebo'}">
    <xacro:include filename="$(find base101_description)/urdf/base101.gazebo.ros2control"/>
    <xacro:include filename="$(find base101_description)/urdf/base101_$(arg variant).gazebo"/>
    <xacro:if value="$(arg tower)">
      <xacro:include filename="$(find base101_description)/urdf/base101_tower.gazebo"/>
    </xacro:if>
  </xacro:if>

  <xacro:if value="${'$(arg simulator)' == 'mujoco'}">
    <xacro:include filename="$(find base101_description)/urdf/base101.mujoco.ros2control"/>
  </xacro:if>

  <!-- simulator=isaac: drives joints natively from base101_isaac, no
       ros2_control block. simulator=none: real-hardware ros2_control is
       included from base101_control. -->

</robot>
