  <parent link="box_left_1"/>
  <child link="motor_support_BL_1"/>
</joint>

<!-- Virtual sensor frame for the 2D laser scan. Sits at the XY geometric
     centre of the lidar mesh (taken from lidar_1's inertial origin) and 3 cm
     above that centre on Z, which is roughly the rotating-laser plane on an
     RPLidar-class unit. /scan is published in this frame (see the gpu_lidar
     <gz_frame_id> in base101_simple.gazebo). -->
<link name="lidar_frame"/>
<joint name="lidar_frame_joint" type="fixed">
  <origin xyz="-0.021416 -0.021595 0.044018" rpy="0 0 0"/>
  <parent link="lidar_1"/>
  <child link="lidar_frame"/>
</joint>

</robot>
