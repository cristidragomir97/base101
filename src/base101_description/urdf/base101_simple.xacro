  <child link="wheel_outside_BR_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Rigid 63" type="fixed">
  <!-- Y shifted from -0.128137 so left/right boxes (and the wheels hanging
       off them) are symmetric about base_link. Paired with the matching
       shift on Rigid 64 below. CAD model has base_link offset 8mm to the
       right of the chassis centerline; this patches it in URDF. -->
  <origin xyz="0.174675 -0.120 0.010149" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="box_right_1"/>
</joint>

<joint name="Rigid 64" type="fixed">
  <!-- Y shifted from 0.111863. Paired with Rigid 63 above so the chassis
       centerline matches base_link Y=0. -->
  <origin xyz="0.174675 0.120 0.010149" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="box_left_1"/>
</joint>

<joint name="Rigid 65" type="fixed">
