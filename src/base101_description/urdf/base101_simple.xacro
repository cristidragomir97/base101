  <parent link="motor_support_FR_1"/>
  <child link="wheel_inside_FR_1"/>
</joint>

<joint name="wheel_front_right" type="continuous">
  <origin xyz="0.0 -0.019416 0.0" rpy="0 0 0"/>
  <parent link="wheel_inside_FR_1"/>
  <child link="wheel_outside_FR_1"/>
  <!-- Normalised to +Y so diff_drive_controller's forward command (+vel to
       all wheels) actually moves the robot forward instead of spinning it.
       Fusion exports per-wheel axes pointing outward from the chassis. -->
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Rigid 54" type="fixed">
  <origin xyz="-0.025436 0.0 0.02042" rpy="0 0 0"/>
  <parent link="box_left_1"/>
