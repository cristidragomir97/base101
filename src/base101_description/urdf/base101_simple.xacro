  <parent link="motor_support_FL_1"/>
  <child link="wheel_inside_FL_1"/>
</joint>

<joint name="Rigid 56" type="fixed">
  <!-- Z matched to front (Rigid 55) so all 4 wheels are coplanar. -->
  <origin xyz="0.024506 0.0049 -0.006387" rpy="0 0 0"/>
  <parent link="motor_support_BL_1"/>
  <child link="wheel_inside_BL_1"/>
</joint>

<joint name="wheel_front_left" type="continuous">
  <origin xyz="0.0 0.019416 0.0" rpy="0 0 0"/>
  <parent link="wheel_inside_FL_1"/>
  <child link="wheel_outside_FL_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="wheel_rear_left" type="continuous">
  <!-- Z matched to wheel_front_left so all 4 wheels are coplanar. -->
  <origin xyz="0.0 0.019416 0.0" rpy="0 0 0"/>
  <parent link="wheel_inside_BL_1"/>
  <child link="wheel_outside_BL_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Rigid 60" type="fixed">
