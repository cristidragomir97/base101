<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>base101_isaac</name>
  <version>0.1.0</version>
  <description>NVIDIA Isaac Sim integration for the base101 mobile base. Imports the URDF, attaches lidar + RGB camera, and wires the OmniGraph ROS2 bridge so the same /cmd_vel, /odom, /scan, /joint_states, and /base_camera/image_raw topics work as in gazebo/mujoco.</description>

  <maintainer email="cristidragomir97@gmail.com">Cristian Dragomir</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- isaacsim itself is a pip dependency (NVIDIA-Proprietary), not a rosdep
       key, so it isn't declared here. See README for install instructions. -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>base101_description</exec_depend>
  <exec_depend>base101_control</exec_depend>
  <exec_depend>rosboard</exec_depend>
  <exec_depend>xacro</exec_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
