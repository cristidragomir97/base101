<!--
  Minimal Navigate To Pose for base101 + robocore.

  Plan, follow, fail. No RecoveryNode, no retries, no fallback, no spin
  (dangerous with tower and dual arms), no wait. Nav2 returns ABORTED on
  any failure; the robocore bridge yields NavStatus(phase="stuck") to
  the Python generator and the user's mission script decides what
  happens next. The bridge clears both costmaps before each
  navigate_to call as housekeeping (direct service calls — there is no
  behavior_server in this stack).
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateWithReplanning">
      <RateController hz="1.0">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"
                           error_code_id="{compute_path_error_code}"/>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath"
                  error_code_id="{follow_path_error_code}"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
