<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>base101_nav</name>
  <version>0.1.0</version>
  <description>Nav2 + slam_toolbox + EKF configuration and mode manager for the base101 mobile base</description>

  <maintainer email="cristidragomir97@gmail.com">Cristian Dragomir</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>lifecycle_msgs</depend>

  <!-- Nav2 dependencies -->
  <depend>nav2_map_server</depend>
  <depend>nav2_amcl</depend>
  <depend>nav2_planner</depend>
  <depend>nav2_smac_planner</depend>
  <depend>nav2_controller</depend>
  <depend>nav2_regulated_pure_pursuit_controller</depend>
  <depend>nav2_bt_navigator</depend>
  <depend>nav2_behaviors</depend>
  <depend>nav2_velocity_smoother</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_msgs</depend>

  <!-- SLAM -->
  <depend>slam_toolbox</depend>

  <!-- Sensor fusion -->
  <depend>robot_localization</depend>

  <!-- Optional: autonomous frontier exploration (enable with explore:=true) -->
  <exec_depend>explore_lite</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
