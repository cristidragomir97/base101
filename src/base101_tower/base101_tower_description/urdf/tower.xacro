<joint name="Rigid 79" type="fixed">
  <origin xyz="${tower_mount_xyz}" rpy="0 0 0"/>
  <parent link="${tower_mount_parent}"/>
  <child link="column_1"/>
</joint>

<joint name="lift" type="prismatic">
  <origin xyz="-0.667476 -0.005932 0.689992" rpy="0 0 0"/>
  <parent link="column_1"/>
  <child link="column_mount_1"/>
  <axis xyz="-0.0 -0.0 -1.0"/>
  <!-- Zero is mid-travel; the axis points down, so +0.26 is the bottom of
       the stroke and -0.26 the top (limits from the physical column, not the
       CAD export). Velocity reduced from the export's 100 m/s so sim physics
       stays stable; refine against the real lift actuator. Effort sized for
       the fully loaded carriage (crossbeam + brackets + two mod101 arms,
       ~12 kg -> ~120 N of gravity): a leadscrew lift is self-locking, so a
       generous limit just lets the sim hold position. -->
  <limit upper="0.26" lower="-0.26" effort="400" velocity="0.5"/>
</joint>

<joint name="Rigid 80" type="fixed">
  <origin xyz="0.701476 -0.015068 -0.330742" rpy="0 0 0"/>
  <parent link="column_mount_1"/>
  <child link="connector_1"/>
</joint>

<joint name="Rigid 81" type="fixed">
  <origin xyz="0.0495 0.020899 -0.034561" rpy="0 0 0"/>
  <parent link="connector_1"/>
  <child link="crossbeam_1"/>
</joint>

<joint name="Rigid 82" type="fixed">
  <origin xyz="-0.02 -0.292081 0.000857" rpy="0 0 0"/>
  <parent link="crossbeam_1"/>
  <child link="left_arm_bracket_1"/>
</joint>

<joint name="Rigid 83" type="fixed">
  <origin xyz="-0.02 0.29208 -0.000857" rpy="0 0 0"/>
  <parent link="crossbeam_1"/>
  <child link="right_arm_bracket_1"/>
</joint>

<joint name="Rigid 84" type="fixed">
  <origin xyz="0.0 0.0 0.64" rpy="0 0 0"/>
  <parent link="column_1"/>
  <child link="camera_support_1"/>
</joint>

<joint name="Rigid 85" type="fixed">
  <origin xyz="0.023476 0.0028 0.017125" rpy="0 0 0"/>
  <parent link="head_tilt_1"/>
  <child link="head_camera_1"/>
</joint>

<joint name="head_tilt" type="continuous">
  <origin xyz="-0.01025 0.0018 0.0328" rpy="0 0 0"/>
  <parent link="head_tilt_motor_1"/>
  <child link="head_tilt_1"/>
  <axis xyz="-0.0 1.0 0.0"/>
</joint>

<joint name="Rigid 87" type="fixed">
  <!-- Origin compensated for head_pan_1's relocated frame. -->
  <origin xyz="0.040891 0.016349 0.019838" rpy="0 0 0"/>
  <parent link="head_pan_1"/>
  <child link="head_tilt_motor_1"/>
</joint>

<joint name="Rigid 88" type="fixed">
  <origin xyz="-0.0205 0.0 0.0" rpy="0 0 0"/>
  <parent link="head_tilt_motor_1"/>
  <child link="head_pan_thingy_1"/>
</joint>

<joint name="head_pan" type="continuous">
  <!-- The CAD export anchored this joint at head_pan_1's arbitrary link
       frame, ~15 cm off the real pivot, so panning swung the head in an arc.
       Re-anchored on the pan motor shaft, measured from the mesh geometry:
       the motor's top-face circle and the bracket's bottom hub are both
       centred at design (-0.0219, -0.0549). Zero pose is unchanged —
       head_pan_1's visual/inertial origins and Rigid 87 are compensated.
       Axis flipped to +Z so positive pan turns the head left (CCW, REP-103
       yaw convention). -->
  <origin xyz="0.028959 -0.010299 0.004362" rpy="0 0 0"/>
  <parent link="head_pan_camera_1"/>
  <child link="head_pan_1"/>
  <axis xyz="0.0 0.0 1.0"/>
</joint>

<joint name="Rigid 90" type="fixed">
  <origin xyz="-0.00615 0.00958 0.06" rpy="0 0 0"/>
  <parent link="camera_support_1"/>
  <child link="head_pan_camera_1"/>
</joint>

</robot>
