<?xml version="1.0" ?>
<robot name="base101_tower" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Cross tower add-on (merged from base101_cross_description): a column with
     a prismatic `lift` joint carrying a crossbeam + arm brackets, and a
     pan/tilt head (`head_pan`, `head_tilt`) with cameras on top. Included
     from base101.xacro when tower:=true.

     Link/joint names and origins are kept verbatim from the CAD export.

     Deck mount point: the simple variant exposes the deck as top_plate_1
     (parented through box_back_1). The mount origin lands the column at the
     same physical spot on the deck as the original export — derived as
     old_offset + (old_plate_origin - new_plate_origin) in base_link coords. -->
<xacro:property name="tower_mount_parent" value="top_plate_1"/>
<xacro:property name="tower_mount_xyz" value="0.219384 0.054181 -0.010489"/>

<link name="column_1">
  <inertial>
    <origin xyz="-0.002342141752436938 2.1317594831170295e-05 0.3199294995742388" rpy="0 0 0"/>
    <mass value="10.261070300347177"/>
    <inertia ixx="0.351835" iyy="0.35188" izz="0.003714" ixy="4e-06" iyz="-0.0" ixz="-5e-06"/>
  </inertial>
  <visual>
    <origin xyz="0.044709 0.054181 -0.086638" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_tower_description)/meshes/tower/column_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.044709 0.054181 -0.086638" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find base101_tower_description)/meshes/tower/column_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

