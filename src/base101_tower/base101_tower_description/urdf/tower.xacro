<!-- Link frame relocated onto the pan motor shaft (see the head_pan joint
     below); visual/collision/inertial origins shifted to match. -->
<link name="head_pan_1">
  <inertial>
    <origin xyz="0.031597 -0.000223 -0.009102" rpy="0 0 0"/>
    <mass value="0.5385469321774147"/>
    <inertia ixx="0.000341" iyy="0.000375" izz="0.000154" ixy="-1e-06" iyz="3e-06" ixz="-3.6e-05"/>
  </inertial>
